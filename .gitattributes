# The shell scripts in scripts/ris_*.sh run inside a Linux container on the RIS
# cluster. Git on this machine converts text files to CRLF on checkout, and bash
# treats a trailing \r as part of the command -- a CRLF copy of these fails with
# messages like "$'\r': command not found" that look nothing like a line-ending
# problem. They are checked out verbatim so a fresh clone can be scp'd straight
# to the cluster.
*.sh text eol=lf
